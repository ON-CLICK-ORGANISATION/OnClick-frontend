# Configuration SMTP du formulaire de contact.
# Copier ce fichier en .env pour le local, et saisir les mêmes clés dans
# Vercel > Settings > Environment Variables pour la production.

# Gmail / Google Workspace
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=votre.adresse@gmail.com

# Mot de passe d'application Google (16 caractères), PAS le mot de passe du compte.
# À générer sur https://myaccount.google.com/apppasswords (2FA requise).
SMTP_PASS=par u b e r f m t u w e b s k k

# Adresse qui reçoit les demandes. Si vide, SMTP_USER est utilisé.
CONTACT_TO=contact@onclick.fr
