{
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/demarrer-un-projet",
      "destination": "/contact/",
      "permanent": true
    },
    {
      "source": "/demarrer-un-projet/",
      "destination": "/contact/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
